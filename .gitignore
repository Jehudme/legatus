# ==============================================================================
# Legatus Monorepo .gitignore
# Components: C++20 (CMake/Ninja), Java 21 (Spring Boot / JHipster), JavaFX
# ==============================================================================

# ------------------------------------------------------------------------------
# Operating System & Environment
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# Environment variables & secrets
.env
.env.*
!.env.example
*.pem
*.key
*.p12

# ------------------------------------------------------------------------------
# IDEs & Editor Configuration
# ------------------------------------------------------------------------------
# JetBrains (IntelliJ IDEA, CLion)
.idea/
*.iws
*.iml
*.ipr
out/
!**/src/main/resources/
!**/src/test/resources/

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# Eclipse
.apt_generated
.classpath
.factorypath
.project
.settings
.springBeans

# Neovim / Vim / Emacs
[._]*.s[a-v][a-z]
[._]*.sw[a-p]
[._]s[a-rt-v][a-z]
[._]ss[a-gi-z]
[._]sw[a-p]
*~
\#*\#
.\#*

# ------------------------------------------------------------------------------
# C++ / CMake / Clang / Native Toolchains (`worker/`)
# ------------------------------------------------------------------------------
# Build outputs & cache directories
build/
bin/
lib/
cmake-build-*/
out/

# CMake cache and state
CMakeFiles/
CMakeCache.txt
CMakeScripts/
cmake_install.cmake
install_manifest.txt
compile_commands.json
CTestTestfile.cmake
Testing/
Makefile

# Object, archive, and executable files
*.o
*.obj
*.so
*.so.*
*.dylib
*.dll
*.a
*.lib
*.exe
*.out
*.app

# Clang / LLVM / Sanitizer artifacts
*.dSYM/
*.gcda
*.gcno
*.gcov
vgcore.*
core.*

# ------------------------------------------------------------------------------
# Java / Maven / Spring Boot (`server/` & `studio/`)
# ------------------------------------------------------------------------------
target/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar

# Compiled class files & packages
*.class
*.jar
*.war
*.ear
*.nar

# Logs
logs/
*.log
spring.log

# Crash logs
hs_err_pid*
replay_pid*

# ------------------------------------------------------------------------------
# JHipster / Node / Frontend Tooling (Server management & scaffolding)
# ------------------------------------------------------------------------------
node/
node_modules/
.npm/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# JHipster artifacts & caches
.jhipster/
.cache-loader
.h2.server.properties

# ------------------------------------------------------------------------------
# Database / Local Docker State
# ------------------------------------------------------------------------------
*.h2.db
h2-data/
postgres-data/
*.sql.gz
*.rdb

# ------------------------------------------------------------------------------
# Release Please State
# ------------------------------------------------------------------------------
# Keep manifest and config tracked; ignore temporary release patches
*.patch