<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>

<BorderPane prefHeight="800.0" prefWidth="1280.0"
            stylesheets="@styles.css"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.legatus.studio.controllers.MainCockpitController">

    <top>
        <VBox>
            <fx:include fx:id="titleBar" source="title_bar.fxml" />
            <fx:include fx:id="topRibbon" source="top_ribbon.fxml" />
        </VBox>
    </top>

    <left>
        <fx:include fx:id="navigationRail" source="navigation_rail.fxml" />
    </left>

    <center>
        <StackPane fx:id="contentContainer" style="-fx-background-color: #0f172a;" />
    </center>

    <bottom>
        <fx:include fx:id="drawer" source="drawer.fxml" />
    </bottom>
</BorderPane>
