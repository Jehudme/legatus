<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="gauge-card" stylesheets="@styles.css"
      prefHeight="46.0" maxWidth="Infinity"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.legatus.studio.controllers.QuarantineCardCellController">
    <padding>
        <Insets top="6.0" right="12.0" bottom="6.0" left="12.0" />
    </padding>

    <VBox spacing="2.0">
        <Label fx:id="workerIdLabel" text="worker-node" style="-fx-font-weight: bold; -fx-text-fill: #f8fafc;" />
        <Label fx:id="hostnameLabel" text="node.internal" style="-fx-text-fill: #94a3b8; -fx-font-size: 10px;" />
    </VBox>

    <Region HBox.hgrow="ALWAYS" />

    <Label fx:id="visualCodeLabel" text="Tiger-Galaxy-77" styleClass="visual-code-highlight" style="-fx-font-size: 11px; -fx-padding: 3 8 3 8;" />
</HBox>
