<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<SplitPane dividerPositions="0.6" stylesheets="@styles.css"
           xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.legatus.studio.controllers.SecretsVaultController">

    <!-- Left side: Secrets Table -->
    <VBox spacing="12.0">
        <padding>
            <Insets top="16.0" right="16.0" bottom="16.0" left="16.0" />
        </padding>

        <HBox spacing="12.0" alignment="CENTER_LEFT">
            <Label text="Secrets Vault (AES-256-GCM)" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #f8fafc;" />
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="deleteSecretButton" text="Delete Secret" disable="true" onAction="#onDeleteClicked" style="-fx-background-color: #dc2626; -fx-text-fill: white;" />
        </HBox>

        <TableView fx:id="secretsTable" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="keyCol" text="Secret Key" prefWidth="200.0" />
                <TableColumn fx:id="scopeCol" text="Scope" prefWidth="120.0" />
                <TableColumn fx:id="createdAtCol" text="Created At" prefWidth="200.0" />
            </columns>
        </TableView>
    </VBox>

    <!-- Right side: Add Secret Form -->
    <VBox spacing="16.0" style="-fx-background-color: #0b1120;">
        <padding>
            <Insets top="16.0" right="20.0" bottom="16.0" left="20.0" />
        </padding>

        <Label text="Store Encrypted Secret" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #38bdf8;" />

        <VBox spacing="12.0" styleClass="attestation-card">
            <VBox spacing="4.0">
                <Label text="Secret Key (Unique Identifier)" styleClass="gauge-title" />
                <TextField fx:id="newKeyField" promptText="e.g. AWS_SECRET_ACCESS_KEY" />
            </VBox>

            <VBox spacing="4.0">
                <Label text="Scope (e.g. GLOBAL, DB, COMPUTE)" styleClass="gauge-title" />
                <TextField fx:id="newScopeField" text="GLOBAL" />
            </VBox>

            <VBox spacing="4.0">
                <Label text="Plaintext Secret Value" styleClass="gauge-title" />
                <PasswordField fx:id="newValueField" promptText="••••••••" />
            </VBox>

            <Button fx:id="createSecretButton" text="Store Secret in Vault" onAction="#onCreateClicked"
                    style="-fx-background-color: #0284c7; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 20 8 20;" />
        </VBox>

        <Label fx:id="statusLabel" style="-fx-text-fill: #38bdf8; -fx-font-size: 12px;" wrapText="true" />
    </VBox>
</SplitPane>
