<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<SplitPane dividerPositions="0.68" stylesheets="@styles.css"
           xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.legatus.studio.controllers.FleetTopologyController">

    <!-- Left side: Worker Fleet list and search -->
    <VBox spacing="12.0">
        <padding>
            <Insets top="16.0" right="16.0" bottom="16.0" left="16.0" />
        </padding>

        <HBox spacing="12.0" alignment="CENTER_LEFT">
            <Label text="Worker Fleet Topology" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #f8fafc;" />
            <Region HBox.hgrow="ALWAYS" />
            <ComboBox fx:id="stateFilterCombo" prefWidth="130.0" promptText="All States" />
            <TextField fx:id="searchField" promptText="Search workers..." prefWidth="220.0" />
        </HBox>

        <TableView fx:id="workersTable" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="nameCol" text="Worker Name" prefWidth="160.0" />
                <TableColumn fx:id="coresCol" text="Cores" prefWidth="70.0" />
                <TableColumn fx:id="ipCol" text="Source IP" prefWidth="110.0" />
                <TableColumn fx:id="uptimeCol" text="Uptime" prefWidth="100.0" />
                <TableColumn fx:id="cpuCol" text="CPU Load" prefWidth="120.0" />
                <TableColumn fx:id="ramCol" text="RAM Load" prefWidth="130.0" />
                <TableColumn fx:id="tasksCol" text="Tasks" prefWidth="75.0" />
                <TableColumn fx:id="leaseCol" text="Lease Remaining" prefWidth="130.0" />
                <TableColumn fx:id="stateCol" text="Status" prefWidth="90.0" />
                <TableColumn fx:id="activeCol" text="Active" prefWidth="80.0" />
            </columns>
        </TableView>
    </VBox>

    <!-- Right side: Worker Node Inspector (visible ONLY when selected) -->
    <ScrollPane fitToWidth="true" style="-fx-background: #0b1120; -fx-background-color: #0b1120;">
        <VBox fx:id="inspectorPane" spacing="14.0" style="-fx-background-color: #0b1120;" visible="false" managed="false">
            <padding>
                <Insets top="16.0" right="16.0" bottom="16.0" left="16.0" />
            </padding>

            <Label text="Worker Node Inspector" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #38bdf8;" />

            <!-- Editable Friendly Name -->
            <VBox spacing="6.0" styleClass="gauge-card">
                <Label text="FRIENDLY WORKER NAME" styleClass="gauge-title" />
                <HBox spacing="8.0" alignment="CENTER_LEFT">
                    <TextField fx:id="nameField" promptText="Enter friendly name..." HBox.hgrow="ALWAYS" />
                    <Button fx:id="saveNameButton" text="Save Name" onAction="#onSaveNameClicked"
                            style="-fx-background-color: #0284c7; -fx-text-fill: white; -fx-font-weight: bold;" />
                </HBox>
            </VBox>

            <!-- Identity & Specs -->
            <VBox spacing="8.0" styleClass="gauge-card">
                <Label text="NODE IDENTITY" styleClass="gauge-title" />
                <Label text="Worker UUID:" style="-fx-text-fill: #64748b; -fx-font-size: 10px;" />
                <Label fx:id="selectedWorkerIdLabel" text="--" style="-fx-text-fill: #94a3b8; -fx-font-family: monospace; -fx-font-size: 11px;" />

                <Label text="Hostname:" style="-fx-text-fill: #64748b; -fx-font-size: 10px;" />
                <Label fx:id="selectedHostLabel" text="--" style="-fx-text-fill: #f8fafc; -fx-font-weight: bold;" />

                <Label text="Source IP &amp; OS:" style="-fx-text-fill: #64748b; -fx-font-size: 10px;" />
                <Label fx:id="selectedIpOsLabel" text="--" style="-fx-text-fill: #cbd5e1;" />
            </VBox>

            <!-- State & Governance -->
            <VBox spacing="10.0" styleClass="gauge-card">
                <Label text="STATE &amp; LEASE GOVERNANCE" styleClass="gauge-title" />

                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <Label text="Execution Enabled:" style="-fx-text-fill: #e2e8f0;" />
                    <Region HBox.hgrow="ALWAYS" />
                    <CheckBox fx:id="activeCheckBox" text="Active" onAction="#onActiveToggled" style="-fx-text-fill: #34d399;" />
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <Label text="Auto-Renew Lease:" style="-fx-text-fill: #e2e8f0;" />
                    <Region HBox.hgrow="ALWAYS" />
                    <CheckBox fx:id="autoRenewCheckBox" text="Auto-Renew" onAction="#onAutoRenewToggled" style="-fx-text-fill: #38bdf8;" />
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <Label text="Lease Remaining:" style="-fx-text-fill: #e2e8f0;" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label fx:id="selectedLeaseLabel" text="--" styleClass="badge-online" />
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <Label text="Current State:" style="-fx-text-fill: #e2e8f0;" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label fx:id="selectedStateLabel" text="--" styleClass="badge-online" />
                </HBox>
            </VBox>

            <!-- Threshold Configuration -->
            <VBox spacing="10.0" styleClass="gauge-card">
                <Label text="AUTO-BALANCER THRESHOLDS" styleClass="gauge-title" />

                <VBox spacing="4.0">
                    <HBox alignment="CENTER_LEFT">
                        <Label text="Target CPU Threshold:" style="-fx-text-fill: #cbd5e1; -fx-font-size: 11px;" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label fx:id="targetCpuValueLabel" text="75.0%" style="-fx-text-fill: #38bdf8; -fx-font-weight: bold;" />
                    </HBox>
                    <Slider fx:id="targetCpuSlider" min="50.0" max="95.0" value="75.0" blockIncrement="5.0" />
                </VBox>

                <VBox spacing="4.0">
                    <HBox alignment="CENTER_LEFT">
                        <Label text="Target RAM Threshold:" style="-fx-text-fill: #cbd5e1; -fx-font-size: 11px;" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label fx:id="targetRamValueLabel" text="80.0%" style="-fx-text-fill: #c084fc; -fx-font-weight: bold;" />
                    </HBox>
                    <Slider fx:id="targetRamSlider" min="50.0" max="95.0" value="80.0" blockIncrement="5.0" />
                </VBox>

                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <Label text="Max Concurrent Tasks:" style="-fx-text-fill: #cbd5e1; -fx-font-size: 11px;" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Spinner fx:id="maxTasksSpinner" prefWidth="90.0" />
                </HBox>

                <Button fx:id="saveThresholdsButton" text="Apply Thresholds" onAction="#onSaveThresholdsClicked"
                        maxWidth="Infinity" style="-fx-background-color: #0d9488; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 6 0 6 0;" />
            </VBox>

            <!-- Live Telemetry Meters -->
            <VBox spacing="8.0" styleClass="gauge-card">
                <Label text="LIVE TELEMETRY" styleClass="gauge-title" />
                <HBox alignment="CENTER_LEFT">
                    <Label text="CPU Load:" style="-fx-text-fill: #94a3b8;" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label fx:id="selectedCpuLabel" text="0.0%" style="-fx-text-fill: #38bdf8; -fx-font-weight: bold;" />
                </HBox>
                <HBox alignment="CENTER_LEFT">
                    <Label text="RAM Used:" style="-fx-text-fill: #94a3b8;" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label fx:id="selectedRamLabel" text="0.0 / 0.0 GB" style="-fx-text-fill: #c084fc; -fx-font-weight: bold;" />
                </HBox>
                <HBox alignment="CENTER_LEFT">
                    <Label text="Active Tasks:" style="-fx-text-fill: #94a3b8;" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label fx:id="selectedTasksLabel" text="0" style="-fx-text-fill: #34d399; -fx-font-weight: bold;" />
                </HBox>
            </VBox>

            <!-- Unified Revoke & Delete Worker -->
            <Button fx:id="deleteButton" text="Revoke Lease &amp; Delete Worker" onAction="#onDeleteClicked"
                    maxWidth="Infinity" style="-fx-background-color: #dc2626; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 0 8 0;" />
        </VBox>
    </ScrollPane>
</SplitPane>
