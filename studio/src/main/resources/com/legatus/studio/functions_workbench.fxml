<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<SplitPane dividerPositions="0.6" stylesheets="@styles.css"
           xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.legatus.studio.controllers.FunctionsWorkbenchController">

    <!-- Left side: Registered Functions Table -->
    <VBox spacing="12.0">
        <padding>
            <Insets top="16.0" right="16.0" bottom="16.0" left="16.0" />
        </padding>

        <Label text="Registered Functions &amp; Bytecode" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #f8fafc;" />

        <TableView fx:id="bytecodeTable" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="functionNameCol" text="Function" prefWidth="180.0" />
                <TableColumn fx:id="sha256Col" text="SHA-256 Digest" prefWidth="240.0" />
                <TableColumn fx:id="sizeCol" text="Size (bytes)" prefWidth="100.0" />
            </columns>
        </TableView>
    </VBox>

    <!-- Right side: Bytecode Upload Dropzone -->
    <VBox spacing="16.0" style="-fx-background-color: #0b1120;">
        <padding>
            <Insets top="16.0" right="20.0" bottom="16.0" left="20.0" />
        </padding>

        <Label text="Upload Solix Bytecode (.slxb)" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #38bdf8;" />

        <VBox spacing="10.0" styleClass="attestation-card">
            <Button text="Choose File..." onAction="#onChooseFileClicked" style="-fx-background-color: #334155; -fx-text-fill: white;" />
            <Label fx:id="filePathLabel" text="No file selected." style="-fx-text-fill: #94a3b8; -fx-font-size: 11px;" wrapText="true" />

            <Separator />

            <Label text="CALCULATED SHA-256 DIGEST:" styleClass="gauge-title" />
            <Label fx:id="sha256Label" text="--" style="-fx-font-family: monospace; -fx-font-size: 12px; -fx-text-fill: #34d399;" wrapText="true" />
        </VBox>

        <VBox spacing="4.0">
            <Label text="Function Name" styleClass="gauge-title" />
            <TextField fx:id="functionNameField" promptText="e.g. matrix-factorization" />
        </VBox>

        <VBox spacing="4.0">
            <Label text="Entry Point" styleClass="gauge-title" />
            <TextField fx:id="entrypointField" text="main" />
        </VBox>

        <Button fx:id="uploadButton" text="Register Bytecode" onAction="#onUploadClicked"
                style="-fx-background-color: #0284c7; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 20 8 20;" />

        <Label fx:id="statusLabel" style="-fx-text-fill: #38bdf8; -fx-font-size: 12px;" wrapText="true" />
    </VBox>
</SplitPane>
