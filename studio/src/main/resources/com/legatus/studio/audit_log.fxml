<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="16.0" stylesheets="@styles.css"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.legatus.studio.controllers.AuditLogController">
    <padding>
        <Insets top="16.0" right="16.0" bottom="16.0" left="16.0" />
    </padding>

    <HBox spacing="16.0" alignment="CENTER_LEFT">
        <Label text="Cryptographically Chained Audit Ledger (WORM)" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #f8fafc;" />
        <Region HBox.hgrow="ALWAYS" />
        <TextField fx:id="actorFilterField" promptText="Filter by Actor..." prefWidth="180.0" />
        <TextField fx:id="actionFilterField" promptText="Filter by Action..." prefWidth="180.0" />
        <Button fx:id="verifyChainButton" text="Verify Hash Chain" onAction="#onVerifyClicked"
                style="-fx-background-color: #0284c7; -fx-text-fill: white; -fx-font-weight: bold;" />
    </HBox>

    <HBox spacing="12.0" alignment="CENTER_LEFT" styleClass="gauge-card">
        <Label text="CHAIN INTEGRITY STATUS:" styleClass="gauge-title" />
        <Label fx:id="verificationBadge" text="UNVERIFIED" styleClass="badge-draining" />
        <Label fx:id="verificationDetailsLabel" text="Click Verify to compute genesis-to-head SHA-256 chain." style="-fx-text-fill: #94a3b8; -fx-font-size: 12px;" />
    </HBox>

    <TableView fx:id="auditTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="seqCol" text="Seq #" prefWidth="70.0" />
            <TableColumn fx:id="timestampCol" text="Timestamp" prefWidth="180.0" />
            <TableColumn fx:id="actorCol" text="Actor" prefWidth="140.0" />
            <TableColumn fx:id="actionCol" text="Action" prefWidth="140.0" />
            <TableColumn fx:id="statusCol" text="Status" prefWidth="90.0" />
            <TableColumn fx:id="hashCol" text="Chained SHA-256 Hash" prefWidth="260.0" />
        </columns>
    </TableView>
</VBox>
