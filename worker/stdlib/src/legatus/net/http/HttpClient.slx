package legatus.net.http;

public class HttpClient {
    private static native char[] native_send(char[] method, char[] url, char[] headersJson, char[] body);

    public static char[] sendRaw(char[] method, char[] url, char[] headersJson, char[] body) {
        return native_send(method, url, headersJson, body);
    }

    public static char[] get(char[] url) {
        return native_send("GET", url, "{}", "");
    }

    public static char[] post(char[] url, char[] body) {
        return native_send("POST", url, "{}", body);
    }
}
