package legatus.encoding;

public class Compression {
    private static native int8[] native_deflate(int8[] input);
    private static native int8[] native_inflate(int8[] input);

    public static int8[] deflate(int8[] input) {
        return native_deflate(input);
    }

    public static int8[] inflate(int8[] input) {
        return native_inflate(input);
    }
}
