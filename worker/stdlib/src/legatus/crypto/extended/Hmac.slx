package legatus.crypto.extended;

public class Hmac {
    private static native string native_sha256(string key, string data);
    private static native string native_sha512(string key, string data);

    public static string sha256(string key, string data) {
        return native_sha256(key, data);
    }

    public static string sha512(string key, string data) {
        return native_sha512(key, data);
    }
}
