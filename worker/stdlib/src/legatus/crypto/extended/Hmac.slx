package legatus.crypto.extended;

public class Hmac {
    private static native char[] native_sha256(char[] key, char[] data);
    private static native char[] native_sha512(char[] key, char[] data);

    public static char[] sha256(char[] key, char[] data) {
        return native_sha256(key, data);
    }

    public static char[] sha512(char[] key, char[] data) {
        return native_sha512(key, data);
    }
}
