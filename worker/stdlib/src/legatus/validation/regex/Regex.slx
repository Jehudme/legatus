package legatus.validation.regex;

public class Regex {
    private char[] pattern;

    private static native int64 native_is_match(char[] pattern, char[] text);
    private static native char[] native_replace(char[] pattern, char[] text, char[] replacement);
    private static native char[] native_extract(char[] pattern, char[] text);

    public Regex(char[] pattern) {
        this.pattern = pattern;
    }

    public static bool isMatch(char[] pattern, char[] text) {
        return native_is_match(pattern, text) != 0;
    }

    public static char[] replace(char[] pattern, char[] text, char[] replacement) {
        return native_replace(pattern, text, replacement);
    }

    public static char[] extract(char[] pattern, char[] text) {
        return native_extract(pattern, text);
    }

    public bool matches(char[] text) {
        return native_is_match(this.pattern, text) != 0;
    }
}
