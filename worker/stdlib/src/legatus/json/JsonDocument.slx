package legatus.json;

public class JsonDocument {
    private int64 handle;

    private static native int64 native_parse(string jsonStr);
    private static native string native_stringify(int64 handle);
    private static native string native_get_string(int64 handle, string path);
    private static native int64 native_get_int(int64 handle, string path);
    private static native float64 native_get_double(int64 handle, string path);
    private static native int64 native_get_bool(int64 handle, string path);
    private static native int64 native_contains(int64 handle, string path);
    private static native int64 native_free(int64 handle);

    public JsonDocument(int64 handle) {
        this.handle = handle;
    }

    public static JsonDocument parse(string jsonStr) {
        int64 h = native_parse(jsonStr);
        if (h == 0) {
            return null;
        }
        return new JsonDocument(h);
    }

    public string stringify() {
        if (this.handle == 0) return "null";
        return native_stringify(this.handle);
    }

    public string getString(string path) {
        if (this.handle == 0) return null;
        return native_get_string(this.handle, path);
    }

    public int64 getInt(string path) {
        if (this.handle == 0) return 0;
        return native_get_int(this.handle, path);
    }

    public float64 getDouble(string path) {
        if (this.handle == 0) return 0.0;
        return native_get_double(this.handle, path);
    }

    public bool getBool(string path) {
        if (this.handle == 0) return false;
        return native_get_bool(this.handle, path) != 0;
    }

    public bool contains(string path) {
        if (this.handle == 0) return false;
        return native_contains(this.handle, path) != 0;
    }

    public void close() {
        if (this.handle != 0) {
            native_free(this.handle);
            this.handle = 0;
        }
    }
}
