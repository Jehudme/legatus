<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd
                        http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">
    <!--
        Added the constraints for entity ComputeTask.
    -->
    <changeSet id="20231229210633-2" author="jhipster">

        <addForeignKeyConstraint baseColumnNames="function_function_id"
                                 baseTableName="tasks"
                                 constraintName="fk_tasks__function_id"
                                 referencedColumnNames="function_id"
                                 referencedTableName="functions"
                                 />

        <addForeignKeyConstraint baseColumnNames="assigned_worker_worker_id"
                                 baseTableName="tasks"
                                 constraintName="fk_tasks__assigned_worker_id"
                                 referencedColumnNames="worker_id"
                                 referencedTableName="workers"
                                 />
    </changeSet>
</databaseChangeLog>
